generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          String    @default("TASK_OWNER") // SUPER_ADMIN, DOMAIN_MANAGER, TASK_OWNER, VIEWER
  phone         String?   // For WhatsApp notifications
  password      String    // Hashed
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedTasks    Task[]    @relation("TaskOwner")
  assignedDomains Domain[] @relation("DomainManagers")
  comments      Comment[]
  notifications Notification[]
  activities    ActivityLog[]

  @@map("users")
}

// Domain/Categories
model Domain {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#84cc16") // Default green
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  managers    User[]   @relation("DomainManagers")
  tasks       Task[]

  @@map("domains")
}

// Tasks
model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  status          String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, BLOCKED, LATE
  urgency         String   @default("GREEN") // GREEN, ORANGE, RED
  
  // Timeline
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  
  // Budget
  budget          Float?
  
  // Relations
  ownerId         String
  owner           User     @relation("TaskOwner", fields: [ownerId], references: [id])
  
  domainId        String?
  domain          Domain?  @relation(fields: [domainId], references: [id])
  
  // Dependencies (self-referential)
  dependencies    TaskDependency[] @relation("TaskDependencies")
  dependents      TaskDependency[] @relation("TaskDependents")
  
  // Subtasks/Related
  parentTaskId    String?
  parentTask      Task?    @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks        Task[]   @relation("SubTasks")
  
  // Content
  comments        Comment[]
  attachments     Attachment[]
  
  // Meta
  isMilestone     Boolean  @default(false)
  location        String?  // For map view
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String

  @@map("tasks")
}

// Task Dependencies
model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task   @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

// Comments on tasks
model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// File attachments
model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@map("attachments")
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  type        String   // TASK_ASSIGNED, STATUS_CHANGED, DEADLINE_APPROACHING, DEPENDENCY_RELEASED, COMMENT_ADDED, SYSTEM_MESSAGE
  title       String
  message     String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  isRead      Boolean  @default(false)
  sentVia     String?  // whatsapp, email, in_app
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@map("notifications")
}

// Activity Log for audit trail
model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // e.g., "task_created", "status_changed"
  entityType  String   // "task", "user", "domain"
  entityId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  details     String?  // JSON string with additional details
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

// System settings (for global configuration)
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
